PORT=3001
NODE_ENV=development
LOG_LEVEL=info
# Copiez ce fichier sous le nom `.env` dans `backend/`.
# Remplacez la valeur ci-dessous par votre URI MongoDB reelle (Atlas ou serveur local).
# MongoDB doit utiliser un replica set pour les transactions de POST /data/sync.
# Gardez votre vraie URI dans `.env` uniquement, jamais dans ce fichier ni dans Git.
MONGODB_URI=mongodb://localhost:27017/chocolat?replicaSet=rs0
JSON_BODY_LIMIT=256kb
# Générez au moins 32 octets aléatoires dans le fichier .env uniquement.
JWT_SECRET=
# Premier compte admin en production (mot de passe unique de 12 caractères minimum).
AUTH_BOOTSTRAP_ADMIN_LOGIN=
AUTH_BOOTSTRAP_ADMIN_PASSWORD=
# Origine publique exacte de l'application si l'API est derrière un reverse proxy.
# APP_ORIGIN=https://chocolat.example.com
